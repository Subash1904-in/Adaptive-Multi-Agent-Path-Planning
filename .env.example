# ==============================================================================
# AMAPP Environment Variables Template (Phase 39)
# Copy this file to .env for local and container deployment (never commit .env)
# ==============================================================================

# Security
# In production, set a cryptographically secure random key of at least 32 characters.
# DO NOT use default placeholders when DEBUG=False.
DJANGO_SECRET_KEY=change-me-to-a-secure-random-key-with-at-least-32-chars-for-production

# Debug Mode (strictly False in production)
DEBUG=False

# Hostnames & Origins (comma-separated, without trailing slashes or wildcards)
ALLOWED_HOSTS=localhost,127.0.0.1,backend,frontend,web
CSRF_TRUSTED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:8000,http://127.0.0.1:8000
AMAPP_WS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:8000,http://127.0.0.1:8000

# Container Port Bindings
PORT=3000
BACKEND_PORT=8000

# Persistence & Data Directory (mapped to Docker named volume)
AMAPP_DATA_DIR=/app/data
RUN_MIGRATIONS=true

# Optional External Database Configuration (default: SQLite in AMAPP_DATA_DIR)
# DB_ENGINE=django.db.backends.postgresql
# DATABASE_NAME=amapp
# DB_USER=amapp_user
# DB_PASSWORD=amapp_secure_password
# DB_HOST=db
# DB_PORT=5432

# Optional Redis Channels Layer (default: InMemoryChannelLayer for single Daphne worker)
# REDIS_URL=redis://redis:6379/0
