# ==============================================================================
# AMAPP Backend Environment Variables Template
# Copy this file to .env for local overrides (never commit .env)
# ==============================================================================

# Security
# In production, replace with a secure, cryptographically random key of >= 50 characters.
DJANGO_SECRET_KEY=insecure-dev-key-change-in-production-only-placeholder-32-chars

# Development / Debug Mode
# Set to False in production environments!
DEBUG=True

# Hostname / IP Configuration (comma-separated)
ALLOWED_HOSTS=localhost,127.0.0.1
