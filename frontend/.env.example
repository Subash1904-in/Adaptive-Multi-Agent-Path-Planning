# AMAPP Frontend Environment Configuration Example
# Copy to .env for local overrides. Defaults work automatically with Vite dev proxy.

# Backend REST API Base URL (e.g., http://127.0.0.1:8000/api/v1 or /api/v1 when proxied)
VITE_API_BASE_URL=/api/v1

# Backend WebSocket Base URL (e.g., ws://127.0.0.1:8000/ws/v1 or leave empty for auto-derived window.location)
VITE_WS_BASE_URL=
